# StrainSense Environment Variables
# Copy this file to .env.local and fill in values

# Feature flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SESSION_HISTORY=true
VITE_ENABLE_MOCK_POSE=false

# API (future — not needed for MVP)
VITE_API_URL=

# MediaPipe model path (optional override)
VITE_MEDIAPIPE_MODEL_PATH=
